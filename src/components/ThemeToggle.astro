<button id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
  <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.8" />
    <path
      d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
    />
  </svg>
  <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linejoin="round"
    />
  </svg>
</button>

<style>
  button {
    display: inline-flex;
    align-items: center;
    background: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-muted);
    padding: 0.35rem 0.5rem;
    cursor: pointer;
  }

  button:hover {
    color: var(--text);
    border-color: var(--accent);
  }

  /* show the icon for the theme you'd switch to */
  :global([data-theme='dark']) .moon,
  :global([data-theme='light']) .sun {
    display: none;
  }
</style>

<script>
  document.getElementById('theme-toggle')!.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>
